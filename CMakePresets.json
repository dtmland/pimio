{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Ninja, RelWithDebInfo)",
      "description": "Shared configuration used locally and in CI on all platforms.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PIMIO_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "displayName": "Debug (Ninja)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QT_ASSUME_STDERR_HAS_CONSOLE": "1"
      },
      "filter": {
        "exclude": {
          "label": "studio"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "default-x11",
      "inherits": "default",
      "displayName": "Default tests on X11",
      "environment": {
        "QT_QPA_PLATFORM": "xcb"
      },
      "filter": {
        "exclude": {
          "label": "label-that-matches-nothing"
        }
      }
    },
    {
      "name": "studio",
      "configurePreset": "default",
      "displayName": "Studio GUI tests on the native display",
      "environment": {
        "QT_ASSUME_STDERR_HAS_CONSOLE": "1"
      },
      "filter": {
        "include": {
          "label": "studio"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "QT_ASSUME_STDERR_HAS_CONSOLE": "1"
      },
      "filter": {
        "exclude": {
          "label": "studio"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
