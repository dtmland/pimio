ARG UBUNTU_VERSION=24.04
ARG UBUNTU_AMD64_DIGEST=sha256:52df9b1ee71626e0088f7d400d5c6b5f7bb916f8f0c82b474289a4ece6cf3faf
FROM ubuntu:${UBUNTU_VERSION}@${UBUNTU_AMD64_DIGEST}

ARG QT_VERSION=6.8.3
ARG QT_ARCH=linux_gcc_64
ARG QT_MODULES="qtmultimedia qtimageformats"
ARG AQTINSTALL_VERSION=3.3.0

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        file \
        git \
        libdbus-1-3 \
        libegl1 \
        libfontconfig1 \
        libgl1-mesa-dev \
        libglib2.0-0 \
        libnss3 \
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libx11-6 \
        libx11-xcb1 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-xinerama0 \
        libxcb-xkb1 \
        libxkbcommon-dev \
        libxkbcommon-x11-0 \
        ninja-build \
        p7zip-full \
        patchelf \
        python3 \
        python3-venv \
        tar \
        xauth \
        xvfb \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/aqt \
    && /opt/aqt/bin/pip install --no-cache-dir "aqtinstall==${AQTINSTALL_VERSION}" \
    && /opt/aqt/bin/python -m aqt install-qt linux desktop \
        "${QT_VERSION}" "${QT_ARCH}" --outputdir /opt/Qt \
        --modules ${QT_MODULES}

ENV CMAKE_PREFIX_PATH=/opt/Qt/${QT_VERSION}/gcc_64
ENV PATH=/opt/Qt/${QT_VERSION}/gcc_64/bin:/opt/aqt/bin:${PATH}
ENV QT_ASSUME_STDERR_HAS_CONSOLE=1

WORKDIR /work
