ARG UBUNTU_VERSION
ARG UBUNTU_AMD64_DIGEST
FROM ubuntu:${UBUNTU_VERSION}@${UBUNTU_AMD64_DIGEST}

ARG QT_VERSION
ARG QT_ARCH
ARG QT_MODULES
ARG AQTINSTALL_VERSION

ENV DEBIAN_FRONTEND=noninteractive
COPY linux-packages.txt /tmp/pimio-linux-packages.txt
RUN apt-get update && xargs -a /tmp/pimio-linux-packages.txt \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        file \
        git \
        libdbus-1-3 \
        libfontconfig1 \
        libglib2.0-0 \
        libnss3 \
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libx11-6 \
        libx11-xcb1 \
        p7zip-full \
        patchelf \
        python3 \
        python3-venv \
        tar \
        xauth \
        xvfb \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/aqt \
    && /opt/aqt/bin/pip install --no-cache-dir "aqtinstall==${AQTINSTALL_VERSION}" \
    && /opt/aqt/bin/python -m aqt install-qt linux desktop \
        "${QT_VERSION}" "${QT_ARCH}" --outputdir /opt/Qt \
        --modules ${QT_MODULES}

ENV CMAKE_PREFIX_PATH=/opt/Qt/${QT_VERSION}/gcc_64
ENV PATH=/opt/Qt/${QT_VERSION}/gcc_64/bin:/opt/aqt/bin:${PATH}
ENV QT_ASSUME_STDERR_HAS_CONSOLE=1

WORKDIR /work
